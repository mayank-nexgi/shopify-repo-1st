{% schema %}
{
  "name": "Best Loved Cushion Covers",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Up to 30% Off* — Our Best-Loved Cushion Covers"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Explore our most-loved handcrafted pieces, chosen for their timeless design and everyday elegance."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount Badge Text (e.g. -25%)",
          "default": "-25%"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title",
          "default": "Patchwork Fiesta Cushion Covers - 100% Cotton Chindi | 18\" x 18\" |..."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (If no product selected)"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Sale Price",
          "default": "Rs. 944.00"
        },
        {
          "type": "text",
          "id": "custom_compare_price",
          "label": "Custom Compare Price (Strikethrough)",
          "default": "Rs. 1,259.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Loved Cushion Covers",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-25%",
            "custom_title": "Patchwork Fiesta Cushion Covers - 100% Cotton Chindi | 18\" x 18\" |...",
            "custom_price": "Rs. 944.00",
            "custom_compare_price": "Rs. 1,259.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-16%",
            "custom_title": "Blush and Bloom Hand Embroidered | Textured Cotton...",
            "custom_price": "Rs. 2,204.00",
            "custom_compare_price": "Rs. 2,624.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-17%",
            "custom_title": "Botanical Bird Hand Embroidered | Textured Cotton Cushion Covers |...",
            "custom_price": "Rs. 1,994.00",
            "custom_compare_price": "Rs. 2,415.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-26%",
            "custom_title": "Vintage Botanica | Hand Embroidered Floral Cushion Cove...",
            "custom_price": "Rs. 2,309.00",
            "custom_compare_price": "Rs. 3,149.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .cushions-grid-wrapper {
    background-color: #faf6f0;
    padding: 60px 5%;
    text-align: center;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .cushions-grid-header h2 {
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
    font-family: serif;
    letter-spacing: 0.5px;
  }

  .cushions-grid-header p {
    font-size: 14px;
    color: #666666;
    margin-bottom: 45px;
  }

  .cushions-container-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cushion-prod-card {
    background: transparent;
    text-align: left;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .cushion-img-box {
    position: relative;
    width: 100%;
    height: 340px;
    border-radius: 12px;
    overflow: hidden;
    background-color: #e5e2dc;
  }

  .cushion-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cushion-badge-discount {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #e6a15c;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    z-index: 2;
  }

  .cushion-info {
    padding-top: 15px;
    text-align: center;
  }

  .cushion-info h3 {
    font-size: 14px;
    font-weight: 500;
    color: #222222;
    margin-bottom: 8px;
    line-height: 1.3;
    height: 40px;
    overflow: hidden;
  }

  .cushion-prices {
    font-size: 14px;
  }

  .cushion-compare-price {
    text-decoration: line-through;
    color: #888888;
    margin-right: 8px;
  }

  .cushion-current-price {
    font-weight: 700;
    color: #111111;
  }

  @media (max-width: 1024px) {
    .cushions-container-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .cushions-container-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="cushions-grid-wrapper">
  <div class="cushions-grid-header">
    <h2>{{ section.settings.section_title }}</h2>
    <p>{{ section.settings.section_subtitle }}</p>
  </div>

  <div class="cushions-container-grid">
    {% for block in section.blocks %}
      {% assign prod = block.settings.product %}
      <a href="{{ prod.url | default: '#' }}" class="cushion-prod-card" {{ block.shopify_attributes }}>
        <div class="cushion-img-box">
          {% if block.settings.discount_badge != blank %}
            <span class="cushion-badge-discount">{{ block.settings.discount_badge }}</span>
          {% endif %}

          {% if prod.featured_image %}
            <img src="{{ prod.featured_image | image_url: width: 500 }}" alt="{{ prod.title }}">
          {% elsif block.settings.custom_image %}
            <img src="{{ block.settings.custom_image | image_url: width: 500 }}" alt="Cushion Image">
          {% else %}
            <img src="https://via.placeholder.com/400x450/d8d4cd/333333?text=Cushion+Cover" alt="Placeholder">
          {% endif %}
        </div>

        <div class="cushion-info">
          <h3>{{ prod.title | default: block.settings.custom_title }}</h3>
          <div class="cushion-prices">
            {% if prod.price %}
              {% if prod.compare_at_price > prod.price %}
                <span class="cushion-compare-price">{{ prod.compare_at_price | money }}</span>
              {% endif %}
              <span class="cushion-current-price">{{ prod.price | money }}</span>
            {% else %}
              <span class="cushion-compare-price">{{ block.settings.custom_compare_price }}</span>
              <span class="cushion-current-price">{{ block.settings.custom_price }}</span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>