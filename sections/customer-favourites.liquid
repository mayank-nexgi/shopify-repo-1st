{% schema %}
{
  "name": "Customer Favourites",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "UP TO 20% OFF* — SHOP CUSTOMER FAVOURITES"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "From timeless essentials to statement pieces — discover what makes every corner feel beautifully yours."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount Badge Text",
          "default": "-16%"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title",
          "default": "Asymmetrical Scalloped Bloom – 100% Natural Jute | 2 x 4 ft"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (If no product selected)"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Sale Price",
          "default": "Rs. 2,799.00"
        },
        {
          "type": "text",
          "id": "custom_compare_price",
          "label": "Custom Compare Price (Strikethrough)",
          "default": "Rs. 3,360.00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Favourites",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-16%",
            "custom_title": "Asymmetrical Scalloped Bloom – 100% Natural Jute | 2 x 4 ft",
            "custom_price": "Rs. 2,799.00",
            "custom_compare_price": "Rs. 3,360.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-16%",
            "custom_title": "Midnight Frame 100% Natural Jute Area Rug | 4 x 6 ft",
            "custom_price": "Rs. 4,799.00",
            "custom_compare_price": "Rs. 5,760.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-16%",
            "custom_title": "ColorPlay Chindi Rug – Hand Woven | 100% Cotton | 3 x 5 ft",
            "custom_price": "Rs. 2,799.00",
            "custom_compare_price": "Rs. 3,360.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "discount_badge": "-16%",
            "custom_title": "Sunrise Arch – 100% Natural Jute Braided | 20 x 32 inches",
            "custom_price": "Rs. 1,999.00",
            "custom_compare_price": "Rs. 2,400.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .fav-grid-wrapper {
    background-color: #faf6f0;
    padding: 60px 5%;
    text-align: center;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .fav-grid-header h2 {
    font-size: 28px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
    font-family: serif;
    letter-spacing: 0.5px;
  }

  .fav-grid-header p {
    font-size: 14px;
    color: #666666;
    margin-bottom: 45px;
  }

  .fav-container-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .fav-prod-card {
    background: transparent;
    text-align: left;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }

  .fav-img-box {
    position: relative;
    width: 100%;
    height: 340px;
    border-radius: 12px;
    overflow: hidden;
    background-color: #e5e2dc;
  }

  .fav-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fav-badge-discount {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: #e6a15c;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    z-index: 2;
  }

  .fav-info {
    padding-top: 15px;
    text-align: center;
  }

  .fav-info h3 {
    font-size: 14px;
    font-weight: 500;
    color: #222222;
    margin-bottom: 8px;
    line-height: 1.3;
    height: 40px;
    overflow: hidden;
  }

  .fav-prices {
    font-size: 14px;
  }

  .fav-compare-price {
    text-decoration: line-through;
    color: #888888;
    margin-right: 8px;
  }

  .fav-current-price {
    font-weight: 700;
    color: #111111;
  }

  @media (max-width: 1024px) {
    .fav-container-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .fav-container-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="fav-grid-wrapper">
  <div class="fav-grid-header">
    <h2>{{ section.settings.section_title }}</h2>
    <p>{{ section.settings.section_subtitle }}</p>
  </div>

  <div class="fav-container-grid">
    {% for block in section.blocks %}
      {% assign prod = block.settings.product %}
      <a href="{{ prod.url | default: '#' }}" class="fav-prod-card" {{ block.shopify_attributes }}>
        <div class="fav-img-box">
          {% if block.settings.discount_badge != blank %}
            <span class="fav-badge-discount">{{ block.settings.discount_badge }}</span>
          {% endif %}

          {% if prod.featured_image %}
            <img src="{{ prod.featured_image | image_url: width: 500 }}" alt="{{ prod.title }}">
          {% elsif block.settings.custom_image %}
            <img src="{{ block.settings.custom_image | image_url: width: 500 }}" alt="Favourite Image">
          {% else %}
            <img src="https://via.placeholder.com/400x450/d8d4cd/333333?text=Placeholder" alt="Placeholder">
          {% endif %}
        </div>

        <div class="fav-info">
          <h3>{{ prod.title | default: block.settings.custom_title }}</h3>
          <div class="fav-prices">
            {% if prod.price %}
              {% if prod.compare_at_price > prod.price %}
                <span class="fav-compare-price">{{ prod.compare_at_price | money }}</span>
              {% endif %}
              <span class="fav-current-price">{{ prod.price | money }}</span>
            {% else %}
              <span class="fav-compare-price">{{ block.settings.custom_compare_price }}</span>
              <span class="fav-current-price">{{ block.settings.custom_price }}</span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>