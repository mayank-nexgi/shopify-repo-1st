<div class="custom-section" style="background-color: {{ section.settings.bg_color }}; padding: 40px; text-align: center;">
  
  {%- if section.settings.heading != blank -%}
    <h2 style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.section_link != blank -%}
    <div style="margin-top: 30px;">
      <a href="{{ section.settings.section_link }}" style="padding: 10px 20px; background: #000; color: #fff; text-decoration: none; border-radius: 5px;">
        {{ section.settings.link_text | default: "Learn More" }}
      </a>
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Custom Product Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Custom Section Headimg"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "Button Link",
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button Text",
      "default": "true"
      
    }
  ],
  "presets": [
    {
      "name": "Custom Product Section",
    }
  ]
}
{% endschema %}