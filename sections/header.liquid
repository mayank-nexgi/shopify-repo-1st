<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Header Styling */
  .custom-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 5%;
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    position: relative;
    z-index: 10;
  }

  .header-logo img {
    max-height: 50px;
    width: auto;
    display: block;
  }

  .header-nav ul {
    display: flex;
    list-style: none;
    gap: 30px;
  }

  .header-nav a {
    text-decoration: none;
    color: #333333;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .header-nav a:hover,
  .header-nav a.active {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .header-icons {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header-icons svg {
    width: 20px;
    height: 20px;
    cursor: pointer;
    fill: none;
    stroke: #333;
    stroke-width: 1.8;
  }

  @media (max-width: 768px) {
    .header-nav { display: none; }
  }
</style>

<!-- HEADER -->
<header class="custom-header">
  <div class="header-logo">
    <a href="/">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
      {% else %}
        <strong style="font-family: serif; font-size: 20px;">The Couturiers Home</strong>
      {% endif %}
    </a>
  </div>

  <nav class="header-nav">
    <ul>
      {% for link in linklists[section.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% else %}
        <li><a href="#" class="active">Cushion Covers</a></li>
        <li><a href="#">Lampshades</a></li>
        <li><a href="#">Rugs</a></li>
        <li><a href="#">Table Accents</a></li>
        <li><a href="#">About us</a></li>
      {% endfor %}
    </ul>
  </nav>

  <div class="header-icons">
    <!-- Search Icon -->
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <!-- Wishlist Icon -->
    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
    <!-- Account Icon -->
    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    <!-- Cart Icon -->
    <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}